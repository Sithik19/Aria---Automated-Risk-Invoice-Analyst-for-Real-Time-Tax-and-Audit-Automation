# ARIA - Automated Reconciliation & Intelligent Auditing
# Environment Configuration

# Database (PostgreSQL 18)
DATABASE_URL=postgresql://postgres:root@localhost:5432/aria_db

# Groq Cloud API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Vector Store
QDRANT_STORAGE_PATH=./qdrant_data
QDRANT_COLLECTION=indian_tax_statutes
